/* Generated by {{ generator.name }}:
 * Source filename:  {{ input.name }}
 * Timestamp:        {{ output.time }}
 */
{%+ for typename, type in dataset.types.items() +%}
/**
 * {{ dataset.label }}
 * {{ type.description }}
 *
 * Description:
   {% for line in dataset.description %}
 * {{ line }}
   {% endfor %}
 *
 * Structure:
   {% for line in dataset.dataset_structure %}
 * {{ line }}
   {% endfor %}
 */
export type {{ type.name }} = {% raw %}{{% endraw %}
    {% for variable in type.variables %}
    {{ '' }}
    /**
       {% for line in variable.description %}
     * {{ line }}
       {% endfor %}
     *
       {% for key, value in variable.properties.items() %}
     * @items.{{ key }} {{ value }}
       {% endfor %}
     * @items.sqltype {{ variable.sql_type }}
     */
    {{ variable.name }}: {{ variable.ts_type }}
    {% endfor %}
{% raw %}}{% endraw %}
{%+ endfor +%}
